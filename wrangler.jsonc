// Cloudflare deployment: one Worker serves the built frontend as static assets
// and runs the auth service for /api/* only. Static requests never invoke the
// Worker, so the app keeps loading even if the Worker hits its daily limit.
//
//   bunx wrangler secret put GOOGLE_CLIENT_ID      (and GOOGLE_CLIENT_SECRET, SESSION_SECRET)
//   bun run deploy
{
  "name": "wallet-app",
  "main": "auth-service/src/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
