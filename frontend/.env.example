VITE_GOOGLE_CLIENT_ID=

# Filled into the Privacy Policy and Terms of Service (src/legal/*.md) at build time.
# They describe whoever runs this deployment.
VITE_APP_NAME=mtWallet
# A person or a company
VITE_LEGAL_OPERATOR=
VITE_LEGAL_CONTACT_EMAIL=
# Where the app is published, e.g. https://wallet.example.com
VITE_LEGAL_WEBSITE=
# Completes "These terms are governed by the laws of ...", e.g. the Republic of Indonesia
VITE_LEGAL_GOVERNING_LAW=
